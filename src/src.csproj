<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>QuantiveCorp.Framework.Middleman </PackageId>
        <Version>1.1.0</Version>
        <Authors>KatanaSGC</Authors>
        <Description>This package is an implementation of the mediator pattern.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/KatanaSGC/sge.framework.middleman</PackageProjectUrl>
        <RepositoryUrl>https://github.com/KatanaSGC/sge.framework.middleman</RepositoryUrl>
